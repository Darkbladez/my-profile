---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ServicesCarousel from '../components/ServicesCarousel.astro';
import EcosystemFooter from '../components/EcosystemFooter.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Miguel Jiménez | Infraestructura TI, Ciberseguridad & Sistemas</title>
    <meta
      name="description"
      content="Portafolio profesional de Miguel Ángel Jiménez Polanco. Especialista en infraestructura TI, ciberseguridad perimetral, servidores, respaldos y desarrollo web."
    />
    <!-- Tipografías Editorial (Lora) + Sans Técnica (Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper text-ink antialiased selection:bg-chalk selection:text-ink">
    <Navbar />
    <main>
      <Hero />
      <ServicesCarousel />
      <EcosystemFooter />
    </main>
  </body>
</html>