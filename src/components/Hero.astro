---
---

<section id="inicio" class="min-h-screen pt-24 pb-12 px-6 flex flex-col justify-between max-w-6xl mx-auto">
  <div class="my-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    
    <!-- Columna Izquierda: Foto + Redes -->
    <div class="lg:col-span-4 flex flex-col items-center">
      <div class="relative w-60 sm:w-68 aspect-4/5 rounded-2xl overflow-hidden bg-white border-2 border-chalk shadow-sm">
        <!-- Coloca tu foto como public/perfil.jpg -->
        <img
          src="/perfil.jpeg"
          alt="Miguel Ángel Jiménez Polanco"
          class="w-full h-full object-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <!-- Respaldo elegante mientras subes tu foto -->
        <div class="hidden w-full h-full flex-col items-center justify-center bg-chalk/25 text-ink p-6 text-center">
          <span class="font-serif text-4xl font-bold text-walnut tracking-wider">MJ</span>
          <span class="text-xs text-ink/60 mt-2">Guarda tu foto en<br/><code class="text-cobalt">public/perfil.jpg</code></span>
        </div>
      </div>

      <!-- Redes sociales debajo de la foto -->
      <div class="mt-5 flex items-center gap-3">
        <a
          href="https://www.linkedin.com/in/miguel-angel-jimenez-polanco-b4651a1a8/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="p-2.5 rounded-xl bg-white border border-chalk/80 text-ink hover:text-cobalt hover:border-cobalt transition-all shadow-2xs"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
        </a>

        <a
          href="https://github.com/Darkbladez"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="p-2.5 rounded-xl bg-white border border-chalk/80 text-ink hover:text-cobalt hover:border-cobalt transition-all shadow-2xs"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33c.85 0 1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/>
          </svg>
        </a>

        <a
          href="mailto:zmiguelz04@gmail.com"
          aria-label="Correo Electrónico"
          class="p-2.5 rounded-xl bg-white border border-chalk/80 text-ink hover:text-cobalt hover:border-cobalt transition-all shadow-2xs"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </a>

        <a
          href="https://wa.me/18095101810"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="p-2.5 rounded-xl bg-white border border-chalk/80 text-ink hover:text-walnut hover:border-walnut transition-all shadow-2xs"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Resumen Editorial + Métricas -->
    <div class="lg:col-span-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-chalk/35 text-walnut text-xs font-semibold tracking-wide mb-5">
        Infraestructura TI · Ciberseguridad · Sistemas Empresariales
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-[2.75rem] font-bold text-ink leading-[1.2] tracking-tight">
        Profesional de la tecnología con <span class="chalk-mark"> 4 años de trayectoria</span> ayudando a empresas a <span class="chalk-mark">cumplir sus objetivos</span> con eficiencia y seguridad.
      </h1>

      <p class="mt-5 text-base sm:text-lg text-ink/80 leading-relaxed max-w-2xl">
        Especialista en arquitectura de infraestructura, servidores, ciberseguridad perimetral y continuidad operativa. He acompañado a pequeñas, medianas y grandes empresas en República Dominicana a ordenar sus sistemas, blindar su información y operar sin interrupciones.
      </p>

      <!-- Métricas clave -->
      <!-- Certificaciones y marcas respaldadas -->
      <div class="mt-8 pt-6 border-t border-chalk/70 max-w-xl">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-walnut mb-3">
          Certificaciones & Respaldo Oficial
        </p>

        <div class="grid grid-cols-3 gap-3 sm:gap-4">
          <!-- Marca / Certificación 1 -->
          <div class="bg-white border border-chalk/80 rounded-xl p-3.5 flex flex-col items-center justify-center text-center shadow-2xs hover:border-cobalt/50 transition-colors">
            <div class="h-10 flex items-center justify-center">
              <img
                src="/certs/cisco.png"
                alt="Certificación Cisco"
                class="max-h-9 w-auto object-contain"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <span class="hidden font-serif font-bold text-sm text-cobalt tracking-wide">Honeywell</span>
            </div>
            <span class="text-[11px] font-medium text-ink/75 mt-2 leading-tight">Control de acceso</span>
          </div>

          <!-- Marca / Certificación 2 -->
          <div class="bg-white border border-chalk/80 rounded-xl p-3.5 flex flex-col items-center justify-center text-center shadow-2xs hover:border-cobalt/50 transition-colors">
            <div class="h-10 flex items-center justify-center">
              <img
                src="/certs/icrea.png"
                alt="Certificación ICREA Data Center"
                class="max-h-9 w-auto object-contain"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <span class="hidden font-serif font-bold text-sm text-walnut tracking-wide">ICREA</span>
            </div>
            <span class="text-[11px] font-medium text-ink/75 mt-2 leading-tight">Data Center CCDR</span>
          </div>

          <!-- Marca / Certificación 3 -->
          <div class="bg-white border border-chalk/80 rounded-xl p-3.5 flex flex-col items-center justify-center text-center shadow-2xs hover:border-cobalt/50 transition-colors">
            <div class="h-10 flex items-center justify-center">
              <img
                src="/certs/sophos.png"
                alt="Certificación Sophos"
                class="max-h-9 w-auto object-contain"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <span class="hidden font-serif font-bold text-sm text-cobalt tracking-wide">SOPHOS</span>
            </div>
            <span class="text-[11px] font-medium text-ink/75 mt-2 leading-tight">Seguridad Perimetral</span>
          </div>
        </div>
      </div>
      
    </div>
  </div>

  <!-- Banner de cierre sutil (Reclutamiento + Consultoría) -->
  <div class="mt-10 bg-white border border-chalk/80 rounded-2xl p-4 sm:px-6 sm:py-4 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-2xs">
    <div class="flex items-center gap-3 text-center sm:text-left">
      <span class="hidden sm:inline-block w-2.5 h-2.5 rounded-full bg-cobalt shrink-0"></span>
      <p class="text-sm text-ink/85 font-medium">
        Disponible para <span class="font-semibold text-ink">roles de Infraestructura/Seguridad TI</span> y <span class="font-semibold text-ink">consultoría de sistemas para empresas</span>.
      </p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <a
        href="#servicios"
        class="text-xs font-semibold text-walnut hover:underline px-3 py-2"
      >
        Ver servicios ↓
      </a>
      <a
        href="https://wa.me/18095101810?text=Hola%20Miguel,%20me%20interesa%20conversar%20contigo%20sobre%20una%20oportunidad%20/%20consultor%C3%ADa%20TI."
        target="_blank"
        rel="noopener noreferrer"
        class="bg-cobalt hover:bg-cobalt/90 text-white text-xs font-semibold px-4 py-2.5 rounded-lg transition-all"
      >
        Trabajemos juntos →
      </a>
    </div>
  </div>
</section>