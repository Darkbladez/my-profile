---
const ecosystems = [
  {
    category: "Ciberseguridad & Endpoint",
    tools: ["Sophos Firewall", "WatchGuard", "Kaspersky Endpoint Security", "OpenVPN"],
  },
  {
    category: "Servidores, Cloud & Virtualización",
    tools: ["Windows Server (AD)", "Linux", "Proxmox", "VMware", "Microsoft 365", "cPanel"],
  },
  {
    category: "Almacenamiento, Backup & VoIP",
    tools: ["TrueNAS", "Acronis", "Yeastar", "Grandstream", "Asterisk"],
  },
  {
    category: "Networking & Seguridad Enterprise",
    tools: ["Cisco Networking", "Honeywell Pro-Watch", "Hikvision"],
  },
];

const credentials = [
  {
    title: "Técnico Superior en Seguridad Informática",
    issuer: "Instituto Tecnológico de las Américas (ITLA)",
    badge: "Formación Académica",
  },
  {
    title: "Certificación en Networking (CCNA)",
    issuer: "Infraestructura, Switching y Enrutamiento Empresarial",
    badge: "Redes",
  },
  {
    title: "Certified Critical Data Center Expert (CCDR)",
    issuer: "Normativa ICREA-Std-131 en Infraestructura Crítica y Energía",
    badge: "Data Center",
  },
  {
    title: "Liderazgo Técnico y Gestión de Proyectos",
    issuer: "Dirección de equipos técnicos y despliegues corporativos y hospitalarios",
    badge: "Experiencia",
  },
];
---

<section id="trayectoria" class="min-h-screen pt-20 pb-8 px-6 flex flex-col justify-between border-t border-chalk/60 max-w-6xl mx-auto">
  <div>
    <!-- Encabezado Sección 3 -->
    <div class="mb-10">
      <span class="text-xs font-semibold uppercase tracking-wider text-walnut">Respaldo Técnico</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-ink mt-1">
        Tecnologías que domino y <span class="chalk-mark">certificaciones</span>
      </h2>
    </div>

    <!-- Bloque A: Marcas y Plataformas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {ecosystems.map((group) => (
        <div class="bg-white border border-chalk/80 rounded-2xl p-5 shadow-2xs">
          <h3 class="text-xs font-bold uppercase tracking-wider text-cobalt pb-3 mb-3 border-b border-chalk/60">
            {group.category}
          </h3>
          <ul class="space-y-2">
            {group.tools.map((tool) => (
              <li class="text-sm font-medium text-ink/85 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-walnut/80 shrink-0"></span>
                {tool}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bloque B: Formación y Certificaciones -->
    <div class="mt-10">
      <h3 class="font-serif text-xl font-bold text-ink mb-4">Formación & Credenciales</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {credentials.map((cred) => (
          <div class="bg-white border border-chalk/80 rounded-xl p-4 sm:p-5 flex items-start justify-between gap-4">
            <div>
              <h4 class="font-bold text-ink text-sm sm:text-base">{cred.title}</h4>
              <p class="text-xs sm:text-sm text-ink/70 mt-1">{cred.issuer}</p>
            </div>
            <span class="shrink-0 text-[11px] font-semibold px-2.5 py-1 rounded-md bg-chalk/35 text-walnut">
              {cred.badge}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bloque C: Footer Integrado -->
  <footer class="mt-14 pt-6 border-t border-chalk/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink/75">
    <div class="text-center sm:text-left">
      <p class="font-serif font-bold text-sm text-ink">Miguel Ángel Jiménez Polanco</p>
      <p class="mt-0.5">Santo Domingo, República Dominicana · © 2026</p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-4 font-medium">
      <a href="mailto:zmiguelz04@gmail.com" class="hover:text-cobalt transition-colors">
        zmiguelz04@gmail.com
      </a>
      <span class="text-chalk">|</span>
      <a href="https://wa.me/18095101810" target="_blank" rel="noopener noreferrer" class="hover:text-cobalt transition-colors">
        +1 809-510-1810
      </a>
      <span class="text-chalk">|</span>
      <a href="https://www.linkedin.com/in/miguel-angel-jimenez-polanco-b4651a1a8/" target="_blank" rel="noopener noreferrer" class="hover:text-cobalt transition-colors">
        LinkedIn
      </a>
      <span class="text-chalk">|</span>
      <a href="https://github.com/Darkbladez" target="_blank" rel="noopener noreferrer" class="hover:text-cobalt transition-colors">
        GitHub
      </a>
      <a href="#inicio" class="ml-2 px-3 py-1.5 rounded-lg bg-white border border-chalk text-ink hover:border-cobalt hover:text-cobalt transition-all">
        Subir ↑
      </a>
    </div>
  </footer>
</section>
