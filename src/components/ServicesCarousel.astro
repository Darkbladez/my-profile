---
const services = [
  {
    number: "01",
    tag: "Protección & Perímetro",
    title: "Diseño y Soluciones de Ciberseguridad Perimetral",
    description:
      "Arquitectura de protección para redes empresariales mediante Firewalls de Siguiente Generación (NGFW), interconexión segura entre sucursales (VPN Site-to-Site y acceso remoto) y políticas de seguridad Endpoint para blindar los activos digitales de tu empresa.",
    highlights: ["Firewalls NGFW (Sophos / WatchGuard)", "VPN Segura entre sucursales", "Protección Endpoint centralizada"],
    ctaText: "Consultar sobre Ciberseguridad →",
    whatsappMsg: "Hola Miguel, me interesa conversar sobre Diseño y Soluciones de Ciberseguridad Perimetral para mi empresa.",
    diagramType: "security",
  },
  {
    number: "02",
    tag: "Eficiencia Operativa",
    title: "Consultoría de Sistemas, Servidores y Almacenamiento",
    description:
      "Implementación y ordenamiento de la columna vertebral operativa de PyMEs: servidores de archivos centralizados, trabajo colaborativo en red, correo corporativo, telefonía IP y virtualización para eliminar el desorden operativo y agilizar el trabajo diario.",
    highlights: ["Almacenamiento compartido y permisos", "Virtualización y servidores Windows/Linux", "Correo corporativo y Telefonía IP"],
    ctaText: "Optimizar mis Sistemas →",
    whatsappMsg: "Hola Miguel, me gustaría recibir consultoría para organizar los servidores y sistemas de mi negocio.",
    diagramType: "systems",
  },
  {
    number: "03",
    tag: "Continuidad de Negocio",
    title: "Estrategias de Respaldo y Recuperación (Backups)",
    description:
      "Diseño de planes de respaldo automatizado y recuperación ante desastres (en servidor local y nube) para proteger la información crítica de tu empresa frente a fallos de hardware, errores humanos o ataques de ransomware.",
    highlights: ["Copias automatizadas programadas", "Esquema híbrido local + nube", "Pruebas de restauración ante fallos"],
    ctaText: "Blindar mi Información →",
    whatsappMsg: "Hola Miguel, quiero implementar una estrategia de respaldos (backups) segura para mi empresa.",
    diagramType: "backup",
  },
  {
    number: "04",
    tag: "Presencia Digital",
    title: "Desarrollo Web de Presentación Empresarial",
    description:
      "Diseño y creación de sitios web informativos ultrarrápidos, modernos y adaptables a cualquier dispositivo, enfocados en proyectar autoridad, mostrar tus servicios con claridad y renovar la imagen digital de tu empresa frente a la competencia.",
    highlights: ["Diseño moderno y 100% adaptable", "Carga ultrarrápida y optimizada", "Enfoque claro en captación de clientes"],
    ctaText: "Cotizar Sitio Web →",
    whatsappMsg: "Hola Miguel, me interesa cotizar una página web de presentación para mi empresa.",
    diagramType: "web",
  },
];
---

<section id="servicios" class="min-h-screen py-20 px-6 flex flex-col justify-center border-t border-chalk/60 bg-white/50">
  <div class="max-w-6xl mx-auto w-full">
    
    <!-- Encabezado y controles desktop -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-walnut">Soluciones & Consultoría</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-ink mt-1">
          ¿Cómo puedo <span class="chalk-mark">aportar valor</span> a tu empresa?
        </h2>
      </div>

      <div class="flex items-center gap-2 self-end sm:self-auto">
        <button
          id="prev-slide"
          aria-label="Servicio anterior"
          class="p-2.5 rounded-xl bg-white border border-chalk text-ink hover:border-cobalt hover:text-cobalt transition-all cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="next-slide"
          aria-label="Siguiente servicio"
          class="p-2.5 rounded-xl bg-white border border-chalk text-ink hover:border-cobalt hover:text-cobalt transition-all cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Track del Carrusel (Soporta Swipe táctil en móviles) -->
    <div
      id="services-track"
      class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar gap-6"
    >
      {services.map((service) => (
        <article class="min-w-full snap-center bg-white border border-chalk/80 rounded-2xl p-6 sm:p-10 shadow-xs">
          <!-- Título Superior de la Tarjeta -->
          <div class="flex flex-wrap items-center justify-between gap-2 pb-6 border-b border-chalk/60">
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-ink">
              {service.title}
            </h3>
            <span class="text-xs font-mono font-semibold text-walnut bg-chalk/30 px-3 py-1 rounded-full">
              {service.number} / 04 · {service.tag}
            </span>
          </div>

          <!-- Contenido: Esquema Visual Izquierda + Descripción Derecha -->
          <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <!-- Imagen / Esquema Técnico Izquierda -->
            <div class="md:col-span-5 bg-paper border border-chalk/70 rounded-xl p-6 flex items-center justify-center min-h-55">
              {service.diagramType === "security" && (
                <svg class="w-full max-w-60 h-auto" viewBox="0 0 240 160" fill="none">
                  <rect x="20" y="30" width="60" height="40" rx="8" fill="#FAF8F5" stroke="#7C4A2D" stroke-width="2"/>
                  <text x="50" y="54" text-anchor="middle" fill="#0B1320" font-size="10" font-weight="bold">Sede A</text>
                  <rect x="160" y="30" width="60" height="40" rx="8" fill="#FAF8F5" stroke="#7C4A2D" stroke-width="2"/>
                  <text x="190" y="54" text-anchor="middle" fill="#0B1320" font-size="10" font-weight="bold">Remoto</text>
                  <path d="M80 50 H160" stroke="#0047AB" stroke-width="2" stroke-dasharray="4 4"/>
                  <rect x="85" y="95" width="70" height="42" rx="10" fill="#0047AB"/>
                  <text x="120" y="120" text-anchor="middle" fill="#FFFFFF" font-size="10" font-weight="bold">NGFW + VPN</text>
                  <path d="M120 50 V95" stroke="#0047AB" stroke-width="2"/>
                </svg>
              )}
              {service.diagramType === "systems" && (
                <svg class="w-full max-w-60 h-auto" viewBox="0 0 240 160" fill="none">
                  <rect x="75" y="20" width="90" height="42" rx="8" fill="#0047AB"/>
                  <text x="120" y="45" text-anchor="middle" fill="#FFFFFF" font-size="10" font-weight="bold">Servidor Central</text>
                  <path d="M120 62 V90 M55 90 H185 M55 90 V105 M120 90 V105 M185 90 V105" stroke="#7C4A2D" stroke-width="2"/>
                  <rect x="25" y="105" width="60" height="34" rx="6" fill="#FFFFFF" stroke="#E6CCB2" stroke-width="2"/>
                  <text x="55" y="126" text-anchor="middle" fill="#0B1320" font-size="9" font-weight="bold">Archivos</text>
                  <rect x="90" y="105" width="60" height="34" rx="6" fill="#FFFFFF" stroke="#E6CCB2" stroke-width="2"/>
                  <text x="120" y="126" text-anchor="middle" fill="#0B1320" font-size="9" font-weight="bold">Correo</text>
                  <rect x="155" y="105" width="60" height="34" rx="6" fill="#FFFFFF" stroke="#E6CCB2" stroke-width="2"/>
                  <text x="185" y="126" text-anchor="middle" fill="#0B1320" font-size="9" font-weight="bold">VoIP</text>
                </svg>
              )}
              {service.diagramType === "backup" && (
                <svg class="w-full max-w-60 h-auto" viewBox="0 0 240 160" fill="none">
                  <rect x="25" y="55" width="64" height="50" rx="8" fill="#FFFFFF" stroke="#0B1320" stroke-width="2"/>
                  <text x="57" y="84" text-anchor="middle" fill="#0B1320" font-size="10" font-weight="bold">Datos</text>
                  <path d="M89 72 L145 45 M89 88 L145 115" stroke="#0047AB" stroke-width="2"/>
                  <rect x="145" y="25" width="70" height="38" rx="8" fill="#E6CCB2"/>
                  <text x="180" y="48" text-anchor="middle" fill="#0B1320" font-size="9" font-weight="bold">NAS Local</text>
                  <rect x="145" y="97" width="70" height="38" rx="8" fill="#7C4A2D"/>
                  <text x="180" y="120" text-anchor="middle" fill="#FFFFFF" font-size="9" font-weight="bold">Copia Nube</text>
                </svg>
              )}
              {service.diagramType === "web" && (
                <svg class="w-full max-w-60 h-auto" viewBox="0 0 240 160" fill="none">
                  <rect x="30" y="22" width="180" height="116" rx="10" fill="#FFFFFF" stroke="#0B1320" stroke-width="2"/>
                  <line x1="30" y1="44" x2="210" y2="44" stroke="#E6CCB2" stroke-width="2"/>
                  <circle cx="44" cy="33" r="3" fill="#7C4A2D"/>
                  <circle cx="54" cy="33" r="3" fill="#E6CCB2"/>
                  <rect x="46" y="58" width="85" height="14" rx="4" fill="#E6CCB2"/>
                  <rect x="46" y="80" width="145" height="8" rx="4" fill="#0B1320" fill-opacity="0.15"/>
                  <rect x="46" y="94" width="120" height="8" rx="4" fill="#0B1320" fill-opacity="0.15"/>
                  <rect x="46" y="112" width="64" height="16" rx="5" fill="#0047AB"/>
                </svg>
              )}
            </div>

            <!-- Descripción y CTA Derecha -->
            <div class="md:col-span-7 flex flex-col justify-between">
              <p class="text-ink/80 text-base leading-relaxed">
                {service.description}
              </p>

              <ul class="mt-5 space-y-2">
                {service.highlights.map((item) => (
                  <li class="flex items-center gap-2.5 text-sm text-ink/85 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-walnut"></span>
                    {item}
                  </li>
                ))}
              </ul>

              <div class="mt-7">
                <a
                  href={`https://wa.me/18095101810?text=${encodeURIComponent(service.whatsappMsg)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-cobalt hover:bg-cobalt/90 text-white text-sm font-semibold px-5 py-3 rounded-xl transition-all shadow-xs"
                >
                  {service.ctaText}
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Indicadores inferiores (Dots) -->
    <div class="mt-6 flex items-center justify-center gap-2.5" id="carousel-dots">
      {services.map((_, index) => (
        <button
          data-index={index}
          aria-label={`Ir al servicio ${index + 1}`}
          class={`h-2.5 rounded-full transition-all cursor-pointer ${
            index === 0 ? "w-8 bg-cobalt" : "w-2.5 bg-chalk hover:bg-walnut/60"
          }`}
        />
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('services-track');
  const prevBtn = document.getElementById('prev-slide');
  const nextBtn = document.getElementById('next-slide');
  const dots = document.querySelectorAll('#carousel-dots button');

  function updateDots(activeIndex: number) {
    dots.forEach((dot, i) => {
      if (i === activeIndex) {
        dot.classList.remove('w-2.5', 'bg-chalk');
        dot.classList.add('w-8', 'bg-cobalt');
      } else {
        dot.classList.remove('w-8', 'bg-cobalt');
        dot.classList.add('w-2.5', 'bg-chalk');
      }
    });
  }

  function goToSlide(index: number) {
    if (!track) return;
    const slideWidth = track.clientWidth + 24; // ancho + gap-6 (24px)
    track.scrollTo({ left: index * slideWidth, behavior: 'smooth' });
    updateDots(index);
  }

  prevBtn?.addEventListener('click', () => {
    if (!track) return;
    const current = Math.round(track.scrollLeft / (track.clientWidth + 24));
    const target = current > 0 ? current - 1 : dots.length - 1;
    goToSlide(target);
  });

  nextBtn?.addEventListener('click', () => {
    if (!track) return;
    const current = Math.round(track.scrollLeft / (track.clientWidth + 24));
    const target = current < dots.length - 1 ? current + 1 : 0;
    goToSlide(target);
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.getAttribute('data-index'));
      goToSlide(idx);
    });
  });

  // Sincronizar puntos al deslizar con el dedo en móvil
  track?.addEventListener('scroll', () => {
    const current = Math.round(track.scrollLeft / (track.clientWidth + 24));
    updateDots(current);
  }, { passive: true });
</script>