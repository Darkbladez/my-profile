    highlights: [
      "Diseño moderno y 100% adaptable",
      "Carga ultrarrápida y optimizada",
      "Enfoque claro en captación de clientes",
    ],
    ctaText: "Cotizar Sitio Web →",
    whatsappMsg:
      "Hola Miguel, me interesa cotizar una página web de presentación para mi empresa.",
    imageSrc: "/services/web.jpg",
    imageAlt: "Vista de Web Corporativa en escritorio y teléfono móvil",
